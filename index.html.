
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MYSTERY 🌹</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  background: radial-gradient(circle, #42002b, #100010, #000);
  color: white;
  font-family: Georgia, serif;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  text-align: center;
}

.container {
  z-index: 2;
  padding: 25px;
}

h1 {
  font-size: 65px;
  letter-spacing: 8px;
  color: #ff83c5;
  text-shadow: 0 0 25px #ff1493;
}

.subtitle {
  margin-top: 20px;
  font-size: 18px;
  color: #ffd6eb;
}

.flowers {
  font-size: 65px;
  margin: 35px 0;
  animation: move 3s infinite alternate;
}

button {
  padding: 15px 35px;
  border: 1px solid pink;
  border-radius: 30px;
  background: transparent;
  color: white;
  font-size: 17px;
  margin-top: 30px;
  cursor: pointer;
  box-shadow: 0 0 20px #ff1493;
}

button:hover {
  background: #ff1493;
}

#message {
  display: none;
  margin-top: 25px;
  color: #ffb6dc;
  font-size: 20px;
  line-height: 1.7;
}

.petal {
  position: absolute;
  top: -30px;
  animation: fall linear infinite;
}

@keyframes move {
  from { transform: scale(1); }
  to { transform: scale(1.15); }
}

@keyframes fall {
  to {
    transform: translateY(110vh) rotate(720deg);
  }
}
</style>
</head>

<body>

<div class="container">

  <h1>MYSTERY</h1>

  <p class="subtitle">
    Some secrets are too beautiful to explain... ✨
  </p>

  <div class="flowers">
    🌹 🌸 🌷
  </div>

  <button onclick="reveal()">
    Discover The Secret 💌
  </button>

  <div id="message">
    You are someone's beautiful mystery. 💗
    <br>
    Never stop being special. 🌹
  </div>

</div>

<script>
function reveal() {
  document.getElementById("message").style.display = "block";
}

const flowers = ["🌸","🌹","💗","✨","🌷"];

setInterval(() => {
  let petal = document.createElement("div");
  petal.className = "petal";
  petal.innerHTML = flowers[Math.floor(Math.random()*flowers.length)];
  petal.style.left = Math.random()*100 + "vw";
  petal.style.animationDuration = (4+Math.random()*5)+"s";
  petal.style.fontSize = "25px";

  document.body.appendChild(petal);

  setTimeout(() => petal.remove(), 9000);
}, 400);
</script>

</body>
</html>
